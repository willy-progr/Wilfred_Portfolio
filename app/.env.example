# Copy to .env.local for local dev. For Cloudflare Pages, set the same keys in
# Settings → Environment variables (build must see NEXT_PUBLIC_* so they embed in the static bundle).

# https://web3forms.com — create a form, set your inbox, paste the access key
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional: canonical site URL for SEO
# NEXT_PUBLIC_SITE_URL=https://wilfredkivinda.com
